  <link name="r_ankle_roll_link"><inertial><origin xyz="0 0 -0.03" rpy="0 0 0"/><mass value="0.5"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
    <visual><origin xyz="0 0 -0.03" rpy="0 0 0"/><geometry><box size="0.10 0.06 0.06"/></geometry><material name="foot"/></visual></link>
  <joint name="r_ankle_roll_joint" type="revolute"><parent link="r_ankle_pitch_link"/><child link="r_ankle_roll_link"/>
    <origin xyz="0 0 -0.08" rpy="0 0 0"/><axis xyz="1 0 0"/><limit lower="-0.35" upper="0.35" effort="5.0" velocity="4.0"/></joint>
  <link name="r_foot_link"><inertial><origin xyz="0.02 0 -0.02" rpy="0 0 0"/><mass value="0.8"/><inertia ixx="0.003" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.006"/></inertial>
    <visual><origin xyz="0.02 0 -0.02" rpy="0 0 0"/><geometry><box size="0.20 0.10 0.04"/></geometry><material name="foot"/></visual>
    <collision><origin xyz="0.02 0 -0.02" rpy="0 0 0"/><geometry><box size="0.20 0.10 0.04"/></geometry></collision></link>
  <joint name="r_foot_joint" type="fixed"><parent link="r_ankle_roll_link"/><child link="r_foot_link"/>
    <origin xyz="0.02 0 -0.03" rpy="0 0 0"/></joint>

  <!-- SENSOR FRAMES -->
  <link name="imu_link"><inertial><mass value="0.01"/><inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial></link>
  <joint name="imu_joint" type="fixed"><parent link="base_link"/><child link="imu_link"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <link name="l_foot_force_link"><inertial><mass value="0.01"/><inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial></link>
  <joint name="l_foot_force_joint" type="fixed"><parent link="l_foot_link"/><child link="l_foot_force_link"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <link name="r_foot_force_link"><inertial><mass value="0.01"/><inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial></link>
  <joint name="r_foot_force_joint" type="fixed"><parent link="r_foot_link"/><child link="r_foot_force_link"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
