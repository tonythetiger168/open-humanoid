<?xml version="1.0"?>
<robot name="open_humanoid_v1">
  <material name="metal"><color rgba="0.75 0.75 0.78 1"/></material>
  <material name="joint"><color rgba="0.2 0.2 0.25 1"/></material>
  <material name="plastic"><color rgba="0.15 0.15 0.15 1"/></material>
  <material name="foot"><color rgba="0.1 0.1 0.1 1"/></material>

  <!-- BASE LINK (Pelvis) -->
  <link name="base_link">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="4.5"/>
    <inertia ixx="0.025" ixy="0" ixz="0" iyy="0.030" iyz="0" izz="0.020"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.18 0.14 0.10"/></geometry><material name="metal"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.18 0.14 0.10"/></geometry></collision>
  </link>

  <!-- HEAD (2 DoF) -->
  <link name="neck_yaw_link"><inertial><origin xyz="0 0 0.04" rpy="0 0 0"/><mass value="0.3"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
    <visual><origin xyz="0 0 0.04" rpy="0 0 0"/><geometry><cylinder radius="0.025" length="0.08"/></geometry><material name="plastic"/></visual></link>
  <joint name="neck_yaw_joint" type="revolute"><parent link="base_link"/><child link="neck_yaw_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/><axis xyz="0 0 1"/><limit lower="-1.57" upper="1.57" effort="2.0" velocity="3.0"/></joint>
  <link name="neck_pitch_link"><inertial><origin xyz="0 0 0.06" rpy="0 0 0"/><mass value="0.5"/><inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/></inertial>
    <visual><origin xyz="0 0 0.06" rpy="0 0 0"/><geometry><sphere radius="0.06"/></geometry><material name="plastic"/></visual></link>
  <joint name="neck_pitch_joint" type="revolute"><parent link="neck_yaw_link"/><child link="neck_pitch_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-0.78" upper="0.78" effort="2.0" velocity="3.0"/></joint>
  <link name="head_camera_link"><inertial><origin xyz="0.03 0 0" rpy="0 0 0"/><mass value="0.1"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/></inertial>
    <visual><origin xyz="0.03 0 0" rpy="0 0 0"/><geometry><box size="0.04 0.08 0.03"/></geometry><material name="joint"/></visual></link>
  <joint name="head_camera_joint" type="fixed"><parent link="neck_pitch_link"/><child link="head_camera_link"/>
    <origin xyz="0.06 0 0.02" rpy="0 0 0"/></joint>

  <!-- TORSO (2 DoF) -->
  <link name="torso_link"><inertial><origin xyz="0 0 0.12" rpy="0 0 0"/><mass value="3.0"/>
    <inertia ixx="0.015" ixy="0" ixz="0" iyy="0.012" iyz="0" izz="0.010"/></inertial>
    <visual><origin xyz="0 0 0.12" rpy="0 0 0"/><geometry><box size="0.16 0.12 0.24"/></geometry><material name="metal"/></visual>
    <collision><origin xyz="0 0 0.12" rpy="0 0 0"/><geometry><box size="0.16 0.12 0.24"/></geometry></collision></link>
  <joint name="spine_pitch_joint" type="revolute"><parent link="base_link"/><child link="torso_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-0.35" upper="0.35" effort="10.0" velocity="2.0"/></joint>
  <link name="chest_link"><inertial><origin xyz="0 0 0.10" rpy="0 0 0"/><mass value="2.5"/>
